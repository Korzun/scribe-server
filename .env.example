# Copy to .env beside docker-compose.yml. A missing or empty value means the default.

# Host port to publish the vault on. Default 3000.
PORT=3000

# The https origin clients use, as your proxy or tunnel serves it. No trailing
# slash. Leave empty for a LAN-only trial (the admin page then works only on
# http://localhost, because browsers expose WebCrypto only in secure contexts).
PUBLIC_URL=

# Reverse-proxy hops to trust when reading the client IP for rate limiting.
# 1 for a single proxy; 2 for a tunnel in front of a proxy (a tunnel into a
# host like Coolify, for example). Trusting a hop you do not run lets a client
# bypass the limiter, so never set it higher than your real proxy count.
TRUST_PROXY_HOPS=0

# A long random phrase, at least 12 characters. It authorizes creating the
# library on a fresh vault and the keys-lost reset, so it is what stops a
# stranger claiming a vault on a public hostname. Set it for setup, then
# remove it (leave it empty) and run `docker compose up -d` again. Set it
# again only for a keys-lost reset.
SETUP_CODE=

# debug, info, warn or error.
LOG_LEVEL=info
