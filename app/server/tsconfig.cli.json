{
  // Type-checks the command-line client (`scripts/vault-cli.ts`, run with
  // tsx), which lives outside this project so the build never ships it: the
  // build config's `include` is this directory, and nothing in it imports
  // the CLI. The CLI imports the shared client and the crypto from here, so
  // those are checked again through it, against this project's settings.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "types": ["node"]
  },
  "include": ["../../scripts/vault-cli.ts"],
  "exclude": []
}
