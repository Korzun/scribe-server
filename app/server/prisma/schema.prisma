generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Small key/value store for instance-level state (the library id until the
// `library` table exists, later the signing secret and similar).
model Setting {
  key   String @id
  value String

  @@map("settings")
}

// Only a SHA-256 hash of each refresh token is stored, never the token. The
// expiry is milliseconds since epoch; Float avoids Int's 32-bit validation
// limit while still round-tripping correctly through SQLite's INTEGER affinity.
model RefreshToken {
  tokenHash String @id @map("token_hash")
  expiresAt Float  @map("expires_at")

  @@map("refresh_tokens")
}

// The one library a vault holds (spec §4). The server never sees a key in the
// clear: it keeps the salts the client needs to re-derive its keys, an argon2id
// verifier of the client-derived auth key, and the Library Key wrapped under
// the password-derived key. `createdAt` is ms since epoch (Float, see above).
model Library {
  id           String @id
  createdAt    Float  @map("created_at")
  passwordSalt Bytes  @map("password_salt")
  recoverySalt Bytes  @map("recovery_salt")
  authVerifier String @map("auth_verifier")
  passwordWrap Bytes  @map("password_wrap")

  recoveryCodes RecoveryCode[]
  devices       Device[]
  grants        McpGrant[]

  @@map("libraries")
}

// One of the ten single-use recovery codes minted at setup. Each carries its
// own verifier and its own wrap of the Library Key; `usedAt` marks it spent.
model RecoveryCode {
  id           String  @id
  libraryId    String  @map("library_id")
  authVerifier String  @map("auth_verifier")
  wrap         Bytes
  usedAt       Float?  @map("used_at")
  library      Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([libraryId])
  @@map("recovery_codes")
}

// A Mac (or other client) holding a device token (spec §5). Only the SHA-256
// of the token is stored, so a database leak does not yield usable tokens.
model Device {
  id         String  @id
  libraryId  String  @map("library_id")
  name       String
  tokenHash  String  @unique @map("token_hash")
  createdAt  Float   @map("created_at")
  lastSeenAt Float?  @map("last_seen_at")
  revokedAt  Float?  @map("revoked_at")
  library    Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([libraryId])
  @@map("devices")
}

// A meeting the vault has seen (spec §6). Created the first time any of its
// blobs is written; `deletedAt` tombstones it and `purgeAfter` is when the
// collector may drop its blobs (both set by deletion, Task 9). The row itself
// outlives the purge, so a late write from a Mac that missed the tombstone
// still answers 410 rather than quietly resurrecting the meeting.
model Meeting {
  id         String @id
  createdAt  Float  @map("created_at")
  deletedAt  Float? @map("deleted_at")
  purgeAfter Float? @map("purge_after")

  @@map("meetings")
}

// The current revision of one blob (spec §6). `scope` is a meeting UUID or the
// literal 'library'; it is deliberately not a foreign key, since 'library'
// names no row. The ciphertext lives at `<blobsDir>/<aa>/<sha256>`, and two
// rows share one file when their bytes are identical, hence the index on
// `sha256` for the "does anything still reference this file" check.
model Blob {
  scope     String
  kind      String
  revision  Int
  sha256    String
  size      Int
  deviceId  String? @map("device_id")
  updatedAt Float   @map("updated_at")

  @@id([scope, kind])
  @@index([sha256])
  @@map("blobs")
}

// The library-wide change log (spec §6): one row per write and per tombstone.
// A Mac syncs by paging `seq > last_seq`; `seq` is the primary key, so that
// range scan is the table's own order and needs no further index.
model Change {
  seq       Int     @id @default(autoincrement())
  meetingId String? @map("meeting_id")
  kind      String
  revision  Int
  sha256    String?
  size      Int?
  deleted   Boolean
  deviceId  String? @map("device_id")
  at        Float

  @@map("changes")
}

// One resumable chunked upload (spec §7): audio is bigger than the 100 MB a
// typical HTTPS tunnel lets through in one request, so a Mac declares the blob's
// size and SHA-256 here, sends it in parts to `<dataDir>/uploads/<id>/<n>`,
// and completes. `ifMatch` is the precondition the Mac chose at the start;
// `epoch` is the keys-lost reset epoch it began in (services/vault-gate.ts).
// A completed session keeps its row (with `completedAt`) until it expires.
model Upload {
  id             String @id
  deviceId       String @map("device_id")
  scope          String
  kind           String
  declaredSha256 String @map("declared_sha256")
  declaredSize   Int    @map("declared_size")
  partSize       Int    @map("part_size")
  ifMatch        Int?   @map("if_match")
  epoch          Int
  createdAt      Float  @map("created_at")
  expiresAt      Float  @map("expires_at")
  completedAt    Float? @map("completed_at")

  @@index([expiresAt])
  @@map("uploads")
}

// An OAuth client an assistant registered through dynamic client registration
// (spec §10): the SDK's registration document, stored whole as JSON so what
// `getClient` returns is exactly what was registered. `lastGrantedAt` is the
// sweep key: a client the owner never approved is forgotten a day after it
// registered; one that was ever approved is kept, because the assistant keeps
// its `client_id` and reuses it when the owner reconnects.
model McpClient {
  clientId              String     @id @map("client_id")
  clientSecret          String?    @map("client_secret")
  clientIdIssuedAt      Float      @map("client_id_issued_at")
  clientSecretExpiresAt Float?     @map("client_secret_expires_at")
  lastGrantedAt         Float?     @map("last_granted_at")
  metadata              String
  createdAt             Float      @map("created_at")
  grants                McpGrant[]

  @@map("mcp_clients")
}

// The owner's approval of one client: the row the admin page's Assistants card
// lists and "Disconnect" deletes. Codes and tokens, and with them every wrap
// of the Library Key, cascade away with it, which is what makes a disconnect
// immediate. `scopes` is the space-joined granted set (only `library:read`).
model McpGrant {
  id         String                 @id
  libraryId  String                 @map("library_id")
  clientId   String                 @map("client_id")
  scopes     String
  createdAt  Float                  @map("created_at")
  lastUsedAt Float?                 @map("last_used_at")
  library    Library                @relation(fields: [libraryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  client     McpClient              @relation(fields: [clientId], references: [clientId], onDelete: Cascade, onUpdate: Cascade)
  codes      McpAuthorizationCode[]
  tokens     McpToken[]

  @@unique([libraryId, clientId])
  @@map("mcp_grants")
}

// A single-use authorization code the BROWSER minted at consent (spec §10):
// the vault holds only its SHA-256 and `wrap`, the Library Key sealed under a
// key derived from the code, so it can open the key once, when the assistant
// presents the code at the token endpoint. `redirectUri`, `codeChallenge` and
// `resource` are what the code was bound to and are re-checked there.
model McpAuthorizationCode {
  codeHash      String   @id @map("code_hash")
  grantId       String   @map("grant_id")
  redirectUri   String   @map("redirect_uri")
  codeChallenge String   @map("code_challenge")
  resource      String?
  wrap          Bytes
  expiresAt     Float    @map("expires_at")
  grant         McpGrant @relation(fields: [grantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([grantId])
  @@map("mcp_authorization_codes")
}

// An opaque access or refresh token (`kind`), hash only, with the Library Key
// sealed under the key derived from that token. A refresh token is deleted in
// the same statement that reads it. Opening `wrap` needs the raw token, which
// only the assistant holds: the vault's disk never holds the Library Key
// under a key the vault also holds.
model McpToken {
  tokenHash String   @id @map("token_hash")
  grantId   String   @map("grant_id")
  kind      String
  wrap      Bytes
  expiresAt Float    @map("expires_at")
  createdAt Float    @map("created_at")
  grant     McpGrant @relation(fields: [grantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([grantId])
  @@index([expiresAt])
  @@map("mcp_tokens")
}

// One reprocessing job (spec §8). The vault hands out work; a Mac decides its
// own eligibility, claims at most one job with a lease, heartbeats, and
// completes. `status` is queued | leased | done | failed; a leased job whose
// `leaseExpiresAt` has passed is claimable again, and `attempts` counts the
// leases it has had. `requestedBy` is `device:<id>` or `session` today and
// leaves room for `grant:<id>` should an assistant ever be allowed to ask.
model Job {
  id             String  @id
  meetingId      String  @map("meeting_id")
  reason         String
  requestedBy    String  @map("requested_by")
  status         String
  attempts       Int     @default(0)
  leaseDeviceId  String? @map("lease_device_id")
  leaseExpiresAt Float?  @map("lease_expires_at")
  createdAt      Float   @map("created_at")
  startedAt      Float?  @map("started_at")
  finishedAt     Float?  @map("finished_at")
  outcome        String?
  note           String?

  @@index([status, createdAt])
  @@index([meetingId])
  @@map("jobs")
}
